#!/bin/sh
# sysinfo — combined disk / ram / cpu line for a status bar (zellij/zjstatus).
# Aggregates the bare-number per-metric scripts into a labeled line:
#   disk:  67% | ram:  20% | cpu:   8%
bin=$(dirname "$0")
printf 'disk: %3s%% | ram: %3s%% | cpu: %3s%%\n' \
    "$("$bin/disk-info")" "$("$bin/ram-info")" "$("$bin/cpu-info")"

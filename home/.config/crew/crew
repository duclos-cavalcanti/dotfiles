#!/usr/bin/env bash
# crew — your registered tmux "agent" sessions. A harpoon-style registry
# (bookmark / jump / edit) plus a live sidebar (name + status). One registry
# file, two faces. Deliberately minimal; grows as needed (real agent state,
# more per-session info -- those grow in lib/).
#
#   crew add        bookmark the current session
#   crew go <n>     jump to bookmark n (create at its path if not running)
#   crew pick       fzf-pick a bookmark and jump
#   crew list       plain numbered bookmarks
#   crew rm <n>     drop bookmark n
#   crew edit       edit the registry in $EDITOR
#   crew render     draw one sidebar frame
#   crew run        persistent sidebar refresh loop (run inside a pane)
#   crew tmux-statusline   emit a one-line tmux-formatted crew summary (pure;
#                          pipe into a status line from tmux.conf)
#   crew signal <event>    map a Claude hook event -> state for this session

DIR=$(cd "$(dirname "$0")" && pwd)

# Registry lives inside the project folder (self-contained). It's runtime,
# machine-specific state (your session names + paths), so it's .gitignore'd
# -- see ./.gitignore. An ordered list of `name=path` lines; index = line no.
CREW_FILE="$DIR/registry"
# Per-session agent state files (working|done|waiting|idle), written by `signal`
# and read by the renderer. Also runtime -> .gitignore'd.
# shellcheck disable=SC2034  # used by the sourced lib/signal.sh + lib/render.sh
CREW_STATE="$DIR/state"
touch "$CREW_FILE"

# shellcheck source=lib/signal.sh
. "$DIR/lib/signal.sh"   # capture: crew_signal (producer)
# shellcheck source=lib/render.sh
. "$DIR/lib/render.sh"   # display: crew_state + glyphs + render (consumer)

# --- registry (bookmark / jump; formerly the `harpoon` script) --------------

crew_add() {
    local entry name
    entry=$(tmux display -p '#{session_name}=#{session_path}')
    name=${entry%%=*}
    # drop any existing line for this session, then append (dedup)
    { awk -F= -v n="$name" '$1 != n' "$CREW_FILE"; printf '%s\n' "$entry"; } \
        > "$CREW_FILE.tmp" && mv "$CREW_FILE.tmp" "$CREW_FILE"
    tmux display "crew: tracked $name"
}

crew_go() {
    local line name path
    line=$(sed -n "${1}p" "$CREW_FILE")
    [ -z "$line" ] && { tmux display "crew: no bookmark $1"; return 1; }
    name=${line%%=*}
    path=${line#*=}
    tmux has-session -t "=$name" 2>/dev/null || tmux new-session -ds "$name" -c "$path"
    tmux switch-client -t "=$name"
}

crew_pick() {
    local line
    line=$(nl -ba "$CREW_FILE" | fzf --reverse --prompt='crew> ') || return 0
    crew_go "$(printf '%s' "$line" | awk '{print $1}')"
}

crew_list() { nl -ba "$CREW_FILE"; }

crew_rm() {
    awk -v n="$1" 'NR != n' "$CREW_FILE" > "$CREW_FILE.tmp" && mv "$CREW_FILE.tmp" "$CREW_FILE"
}

crew_edit() { "${EDITOR:-vi}" "$CREW_FILE"; }

# --- dispatch ---------------------------------------------------------------

case "$1" in
    add)             crew_add ;;
    go)              crew_go "$2" ;;
    pick)            crew_pick ;;
    list)            crew_list ;;
    rm)              crew_rm "$2" ;;
    edit)            crew_edit ;;
    render)          crew_render ;;
    run)             while :; do clear; crew_render; sleep 2; done ;;
    tmux-statusline) crew_statusline ;;
    signal)          crew_signal "$2" ;;
    *)
        echo "usage: crew {add|go <n>|pick|list|rm <n>|edit|render|run|tmux-statusline|signal <state>}" >&2
        exit 2
        ;;
esac

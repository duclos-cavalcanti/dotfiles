#!/bin/sh
# base16 — render a base16 palette for a specific consumer.
# One source of truth: base16 YAML schemes in $THEME_DIR (default ~/.config/theme).
# Each consumer imports its own data format from the same file.
#
#   base16 ghostty <scheme>    Ghostty theme  -> ghostty/themes/<scheme>, `theme = <scheme>`
#   base16 lua     <scheme>    Lua palette    -> nvim/lua/theme/<scheme>.lua (mini.base16)
#
# <scheme> is a name resolved to $THEME_DIR/<scheme>.yaml, a path, or "-" for stdin.
#
# Add a consumer: write one awk emit_<name>() function and one dispatch branch.
#
# Scheme sources (base16, by the tinted-theming org, formerly chriskempson/base16):
#   github.com/tinted-theming/base16-schemes  legacy FLAT format (scheme:/base00:),
#                                             parsed as-is by this script.
#   github.com/tinted-theming/schemes         canonical NESTED format (palette:, #hex);
#                                             flatten before use (or switch to yq).

THEME_DIR="${THEME_DIR:-$HOME/.config/theme}"

usage() {
    echo "usage: base16 <ghostty|lua> <scheme|path|->" >&2
    exit 2
}

resolve_src() {
    case $1 in
        -) echo /dev/stdin ;;
        */* | *.yaml) echo "$1" ;;
        *) echo "$THEME_DIR/$1.yaml" ;;
    esac
}

# render <consumer> — parse a flat base16 YAML (stdin) into c[] and emit the
# consumer's format. base16 palette -> ANSI(0-15)+256(16-21) map for ghostty.
render() {
    awk -v consumer="$1" '
        /^(scheme|base0[0-9A-Fa-f]):/ {
            key = $1; sub(/:$/, "", key)
            val = $0; sub(/^[^:]*:[[:space:]]*/, "", val); gsub(/"/, "", val)
            c[key] = val
        }

        function emit_ghostty(   ansi, n, i) {
            print "# Scheme: " c["scheme"]
            print "# Generated by base16 (macfiles)"
            print "background = " c["base00"]
            print "foreground = " c["base05"] "\n"
            print "selection-background = " c["base02"]
            print "selection-foreground = " c["base00"] "\n"
            n = split("base00 base08 base0B base0A base0D base0E base0C base05 base03 base08 base0B base0A base0D base0E base0C base07 base09 base0F base01 base02 base04 base06", ansi, " ")
            for (i = 1; i <= n; i++)
                print "palette = " (i - 1) "=#" c[ansi[i]]
        }

        function emit_lua(   keys, n, i) {
            print "-- Scheme: " c["scheme"] " -- GENERATED by `base16 lua`; edit the .yaml source, not this."
            print "return {"
            n = split("base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F", keys, " ")
            for (i = 1; i <= n; i++)
                printf "    %s = \"#%s\",\n", keys[i], c[keys[i]]
            print "}"
        }

        END {
            if (consumer == "ghostty") emit_ghostty()
            else if (consumer == "lua") emit_lua()
        }
    '
}

main() {
    consumer=$1
    scheme=$2
    [ -n "$consumer" ] && [ -n "$scheme" ] || usage
    case $consumer in ghostty | lua) ;; *) usage ;; esac

    src=$(resolve_src "$scheme")
    [ "$src" = /dev/stdin ] || [ -f "$src" ] || {
        echo "base16: no such scheme: $src" >&2
        exit 1
    }
    render "$consumer" <"$src"
}

main "$@"

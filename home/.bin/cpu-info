#!/bin/sh
# cpu-info — CPU busy over a 1s sample and the 1-minute load average, e.g. "15% load 9.6".
# top's second sample covers just that second, as btop does; summing ps %cpu read 2-3x low
# (it decays over a minute and misses processes that exit between samples).
top -l 2 -n 0 -s 1 | awk -v load="$(sysctl -n vm.loadavg | awk '{print $2}')" \
    '/^CPU usage/ {idle = $7} END {printf "%d%% load %.1f\n", 100 - idle + 0.5, load}'

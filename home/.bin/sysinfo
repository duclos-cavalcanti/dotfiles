#!/bin/sh
# sysinfo — combined disk / ram / cpu line for a status bar (zellij/zjstatus).
# Aggregates the per-metric scripts into a labeled line:
#   disk: 88% 54G free | ram: 31/48G swap 5.1G | cpu: 15% load 9.6
bin=$(dirname "$0")
printf 'disk: %s | ram: %s | cpu: %s\n' \
    "$("$bin/disk-info")" "$("$bin/ram-info")" "$("$bin/cpu-info")"

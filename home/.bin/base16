#!/bin/sh
# base16 — render a theme for a specific consumer.
# One source of truth: theme YAMLs in $THEME_DIR (default ~/.macfiles/theme).
# That dir lives in the repo (NOT stowed) — it is a build input; this tool renders
# it into the stowed consumers (ghostty themes, nvim lua).
#
#   base16 ghostty <scheme>    Ghostty theme -> ghostty/themes/<scheme>
#   base16 lua     <scheme>    Lua palette   -> nvim/lua/theme/<scheme>.lua (mini.base16)
#   base16 wezterm <scheme>    Lua config    -> wezterm/theme/<scheme>.lua (colors + tab bar/frame)
#
# <scheme> is a name resolved to $THEME_DIR/<scheme>.yaml, a path, or "-" for stdin.
#
# Scheme format (flat YAML, see theme/andromeda.yaml — the exemplar):
#   terminal : background/foreground/cursor/cursor-text/selection-{background,foreground}
#              + color00..color15 (the 16 ANSI colors, verbatim from source).
#   base16   : base00..base0F (mix of copies from the 16 + inferred slots).
# `ghostty` emits the terminal block verbatim; `lua` emits the base16 block; `wezterm`
# emits the terminal block plus a tab bar/frame derived from base16.
#
# Add a consumer: write one awk emit_<name>() function and one dispatch branch.

THEME_DIR="${THEME_DIR:-$HOME/.macfiles/theme}"

usage() {
    echo "usage: base16 <ghostty|lua|wezterm> <scheme|path|->" >&2
    exit 2
}

resolve_src() {
    case $1 in
        -) echo /dev/stdin ;;
        */* | *.yaml) echo "$1" ;;
        *) echo "$THEME_DIR/$1.yaml" ;;
    esac
}

# render <consumer> — parse a flat YAML (stdin) into c[] and emit the consumer's format.
render() {
    awk -v consumer="$1" '
        /^[A-Za-z][A-Za-z0-9-]*:/ {
            key = $1; sub(/:$/, "", key)
            val = $0; sub(/^[^:]*:[[:space:]]*/, "", val); gsub(/["#]/, "", val)
            c[key] = val
        }

        function emit_ghostty(   i, k) {
            print "# Scheme: " c["scheme"]
            print "# Generated by base16 (macfiles)"
            print "background = #" c["background"]
            print "foreground = #" c["foreground"]
            print "cursor-color = #" c["cursor"]
            print "cursor-text = #" c["cursor-text"]
            print "selection-background = #" c["selection-background"]
            print "selection-foreground = #" c["selection-foreground"]
            for (i = 0; i <= 15; i++) {
                k = sprintf("color%02d", i)
                print "palette = " i "=#" c[k]
            }
        }

        function emit_lua(   keys, n, i) {
            print "-- Scheme: " c["scheme"] " -- GENERATED by `base16 lua`; edit the .yaml source, not this."
            print "return {"
            n = split("base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F", keys, " ")
            for (i = 1; i <= n; i++)
                printf "    %s = \"#%s\",\n", keys[i], c[keys[i]]
            print "}"
        }

        # hex2 / mix — midpoint of two rrggbb colors (BWK awk has no strtonum).
        function hex2(h) { h = tolower(h); return (index("0123456789abcdef", substr(h, 1, 1)) - 1) * 16 + index("0123456789abcdef", substr(h, 2, 1)) - 1 }
        function mix(a, b,   i, out) {
            for (i = 1; i <= 5; i += 2)
                out = out sprintf("%02x", int((hex2(substr(a, i, 2)) + hex2(substr(b, i, 2))) / 2 + 0.5))
            return out
        }

        # Tab bar + window frame follow Flatcap (cheycron/flatcap-wezterm) by role:
        # bar/frame = base01 (surface), edge = base02, active tab = base02 (selected)
        # on base05, inactive = base04 on base01, hover = mix(base01, base02).
        function emit_wezterm(   i, hover) {
            hover = mix(c["base01"], c["base02"])
            print "-- Scheme: " c["scheme"] " -- GENERATED by `base16 wezterm`; edit the .yaml source, not this."
            print "return {"
            print "    colors = {"
            printf "        background = \"#%s\",\n", c["background"]
            printf "        foreground = \"#%s\",\n", c["foreground"]
            printf "        cursor_bg = \"#%s\",\n", c["cursor"]
            printf "        cursor_border = \"#%s\",\n", c["cursor"]
            printf "        cursor_fg = \"#%s\",\n", c["cursor-text"]
            printf "        selection_bg = \"#%s\",\n", c["selection-background"]
            printf "        selection_fg = \"#%s\",\n", c["selection-foreground"]
            printf "        ansi = {"
            for (i = 0; i <= 7; i++) printf " \"#%s\",", c[sprintf("color%02d", i)]
            print " },"
            printf "        brights = {"
            for (i = 8; i <= 15; i++) printf " \"#%s\",", c[sprintf("color%02d", i)]
            print " },"
            print "        tab_bar = {"
            printf "            background = \"#%s\",\n", c["base01"]
            printf "            inactive_tab_edge = \"#%s\",\n", c["base02"]
            printf "            active_tab = { bg_color = \"#%s\", fg_color = \"#%s\", intensity = \"Bold\" },\n", c["base02"], c["base05"]
            printf "            inactive_tab = { bg_color = \"#%s\", fg_color = \"#%s\" },\n", c["base01"], c["base04"]
            printf "            inactive_tab_hover = { bg_color = \"#%s\", fg_color = \"#%s\" },\n", hover, c["base05"]
            printf "            new_tab = { bg_color = \"#%s\", fg_color = \"#%s\" },\n", c["base01"], c["base04"]
            printf "            new_tab_hover = { bg_color = \"#%s\", fg_color = \"#%s\" },\n", hover, c["base05"]
            print "        },"
            print "    },"
            print "    window_frame = {"
            printf "        active_titlebar_bg = \"#%s\",\n", c["base01"]
            printf "        inactive_titlebar_bg = \"#%s\",\n", c["base01"]
            printf "        active_titlebar_fg = \"#%s\",\n", c["base05"]
            printf "        inactive_titlebar_fg = \"#%s\",\n", c["base04"]
            printf "        active_titlebar_border_bottom = \"#%s\",\n", c["base02"]
            printf "        inactive_titlebar_border_bottom = \"#%s\",\n", c["base02"]
            printf "        button_fg = \"#%s\",\n", c["base04"]
            printf "        button_bg = \"#%s\",\n", c["base01"]
            printf "        button_hover_fg = \"#%s\",\n", c["base05"]
            printf "        button_hover_bg = \"#%s\",\n", hover
            print "    },"
            printf "    command_palette_bg_color = \"#%s\",\n", c["base01"]
            printf "    command_palette_fg_color = \"#%s\",\n", c["base05"]
            printf "    char_select_bg_color = \"#%s\",\n", c["base01"]
            printf "    char_select_fg_color = \"#%s\",\n", c["base05"]
            print "}"
        }

        END {
            if (consumer == "ghostty") emit_ghostty()
            else if (consumer == "lua") emit_lua()
            else if (consumer == "wezterm") emit_wezterm()
        }
    '
}

main() {
    consumer=$1
    scheme=$2
    [ -n "$consumer" ] && [ -n "$scheme" ] || usage
    case $consumer in ghostty | lua | wezterm) ;; *) usage ;; esac

    src=$(resolve_src "$scheme")
    [ "$src" = /dev/stdin ] || [ -f "$src" ] || {
        echo "base16: no such scheme: $src" >&2
        exit 1
    }
    render "$consumer" <"$src"
}

main "$@"

#!/bin/sh
# base16 — render a theme for a specific consumer.
# One source of truth: theme YAMLs in $THEME_DIR (default ~/.macfiles/theme).
# That dir lives in the repo (NOT stowed) — it is a build input; this tool renders
# it into the stowed consumers (ghostty themes, nvim lua).
#
#   base16 ghostty <scheme>    Ghostty theme -> ghostty/themes/<scheme>
#   base16 lua     <scheme>    Lua palette   -> nvim/lua/theme/<scheme>.lua (mini.base16)
#
# <scheme> is a name resolved to $THEME_DIR/<scheme>.yaml, a path, or "-" for stdin.
#
# Scheme format (flat YAML, see theme/andromeda.yaml — the exemplar):
#   terminal : background/foreground/cursor/cursor-text/selection-{background,foreground}
#              + color00..color15 (the 16 ANSI colors, verbatim from source).
#   base16   : base00..base0F (mix of copies from the 16 + inferred slots).
# `ghostty` emits the terminal block verbatim; `lua` emits the base16 block.
#
# Add a consumer: write one awk emit_<name>() function and one dispatch branch.

THEME_DIR="${THEME_DIR:-$HOME/.macfiles/theme}"

usage() {
    echo "usage: base16 <ghostty|lua> <scheme|path|->" >&2
    exit 2
}

resolve_src() {
    case $1 in
        -) echo /dev/stdin ;;
        */* | *.yaml) echo "$1" ;;
        *) echo "$THEME_DIR/$1.yaml" ;;
    esac
}

# render <consumer> — parse a flat YAML (stdin) into c[] and emit the consumer's format.
render() {
    awk -v consumer="$1" '
        /^[A-Za-z][A-Za-z0-9-]*:/ {
            key = $1; sub(/:$/, "", key)
            val = $0; sub(/^[^:]*:[[:space:]]*/, "", val); gsub(/["#]/, "", val)
            c[key] = val
        }

        function emit_ghostty(   i, k) {
            print "# Scheme: " c["scheme"]
            print "# Generated by base16 (macfiles)"
            print "background = #" c["background"]
            print "foreground = #" c["foreground"]
            print "cursor-color = #" c["cursor"]
            print "cursor-text = #" c["cursor-text"]
            print "selection-background = #" c["selection-background"]
            print "selection-foreground = #" c["selection-foreground"]
            for (i = 0; i <= 15; i++) {
                k = sprintf("color%02d", i)
                print "palette = " i "=#" c[k]
            }
        }

        function emit_lua(   keys, n, i) {
            print "-- Scheme: " c["scheme"] " -- GENERATED by `base16 lua`; edit the .yaml source, not this."
            print "return {"
            n = split("base00 base01 base02 base03 base04 base05 base06 base07 base08 base09 base0A base0B base0C base0D base0E base0F", keys, " ")
            for (i = 1; i <= n; i++)
                printf "    %s = \"#%s\",\n", keys[i], c[keys[i]]
            print "}"
        }

        END {
            if (consumer == "ghostty") emit_ghostty()
            else if (consumer == "lua") emit_lua()
        }
    '
}

main() {
    consumer=$1
    scheme=$2
    [ -n "$consumer" ] && [ -n "$scheme" ] || usage
    case $consumer in ghostty | lua) ;; *) usage ;; esac

    src=$(resolve_src "$scheme")
    [ "$src" = /dev/stdin ] || [ -f "$src" ] || {
        echo "base16: no such scheme: $src" >&2
        exit 1
    }
    render "$consumer" <"$src"
}

main "$@"
